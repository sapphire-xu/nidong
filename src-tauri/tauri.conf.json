{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "泥洞",
  "version": "2.3.8",
  "identifier": "edu.neu.nidong",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/meter/stage.ps1",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "泥洞",
        "width": 420,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "desk",
        "title": "泥洞",
        "url": "desk.html",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "focus": false,
        "center": false,
        "dragDropEnabled": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420; connect-src ipc: http://ipc.localhost https://ipc.localhost http://localhost:1420 ws://localhost:1420; font-src 'self' data:; media-src 'self' asset: http://asset.localhost https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "sapphire_fic",
    "targets": ["nsis"],
    "externalBin": ["binaries/nidong-meter"],
    "icon": [
      "icons/32x32.png",
      "icons/16x16.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3QjUyMUFFOTBDNEZENTEKUldSUi9jU1FyaUcxZDZhbWk1NVVvQlFmSEtzNDkycUdrNHRka3UrNDRzZGhvbWpGaDIvRGc3dmMK",
      "endpoints": [
        "https://gitee.com/sapphire_fic/nidong/raw/master/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
